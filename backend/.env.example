# Django Secret Key (Generate one or use a secure random string)
SECRET_KEY=your-django-secret-key-here

# Debug Mode: True for development, False for production
DEBUG=True

# Allowed Hosts (comma-separated list, e.g. .onrender.com, .railway.app, localhost)
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,.railway.app

# Supabase PostgreSQL Database Settings
# Find these in Supabase Dashboard -> Project Settings -> Database -> Connection info
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your_supabase_db_password_here
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432

# CORS Allowed Origins (comma-separated list of allowed frontend URLs)
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# CSRF Trusted Origins (comma-separated list of allowed domains)
CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com
